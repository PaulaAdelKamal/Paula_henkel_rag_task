# Copy to .env and fill in the values: cp .env.example .env
# Format rules (docker run --env-file does NOT strip quotes):
#   KEY=value   no quotes, no "export", no comments on the same line as a value.
# Empty optional values fall back to the defaults in app/config.py.

# ===================== Runtime (needed to run the chatbot) =====================

# OpenRouter API key, used for the chat model and the query embeddings (required).
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Qdrant Cloud cluster URL, including https:// and port 6333 (required).
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333

# Qdrant Cloud API key for that cluster (required).
QDRANT_API_KEY=your-qdrant-api-key

# OpenRouter chat model slug used to answer questions (default: google/gemma-4-31b-it:free).
CHAT_MODEL=google/gemma-4-31b-it:free

# Comma-separated free fallbacks OpenRouter tries if the chat model errors or is rate-limited; paid models are ignored.
CHAT_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free

# OpenRouter embedding model slug; must match a model the index was built with (default: nvidia/nemotron-3.5-embed-1b:free).
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

# Optional override of the Qdrant collection name (default: derived from EMBEDDING_MODEL and the chunk config).
QDRANT_COLLECTION=

# Chunk config hash the index was built with; selects the collection (default: edb94b731b, see docs/CHUNKING.md).
CHUNK_CONFIG_HASH=edb94b731b

# Number of chunks retrieved per question (default: 5).
TOP_K=5

# Minimum similarity score for a chunk to count as relevant, calibrated per embedding model (default: 0.0).
RELEVANCE_THRESHOLD=0.0

# Langfuse public key for tracing; leave empty to disable tracing (optional).
LANGFUSE_PUBLIC_KEY=

# Langfuse secret key for tracing; leave empty to disable tracing (optional).
LANGFUSE_SECRET_KEY=

# Langfuse region URL: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US) (optional).
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Port the web UI listens on inside the container (default: 8000).
APP_PORT=8000

# Log verbosity: DEBUG, INFO, WARNING or ERROR (default: INFO).
LOG_LEVEL=INFO

# ============ Offline only (ingestion and evaluation; not needed to chat) ============

# OpenRouter vision model used to caption figures during ingestion (set in Step 2).
VISION_MODEL=

# OpenRouter model used as the Ragas judge; must be a different family than CHAT_MODEL (set in Step 9).
JUDGE_MODEL=

# OpenRouter model used to draft evaluation questions (set in Step 8).
EVAL_GEN_MODEL=

# Directory for content-hash keyed caches of parsing, captions and embeddings (default: data/cache).
CACHE_DIR=data/cache

# Hard budget in USD for one batch of paid offline API calls (default: 5.0).
MAX_SPEND_USD=5.0
